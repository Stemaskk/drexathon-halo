# Copy to .env (never commit .env). All keys are read server-side only.
NACE_API_KEY=nace_sk_your_key_here
DEEPINFRA_API_KEY=your_deepinfra_key_here
KEENABLE_API_KEY=keen_your_key_here

# Optional overrides
NACE_BASE_URL=https://console.nace.ai
DREX_MODEL=drex-latest
DEEPINFRA_MODEL=Qwen/Qwen3.8-27B
# Baseline model for the decision benchmark (any DeepInfra chat model id)
BASELINE_MODEL=Qwen/Qwen3.8-27B
# Prices (USD per 1M tokens) used ONLY for cost estimates; leave blank if unknown.
DREX_PRICE_PER_M_INPUT=
BASELINE_PRICE_PER_M_INPUT=
BASELINE_PRICE_PER_M_OUTPUT=
